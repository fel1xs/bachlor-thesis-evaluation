OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_B=sk-or-v1-...
OPENROUTER_API_KEY_C=sk-or-v1-...
OPENAI_API_KEY=sk-proj-...
AGENT_WEBHOOK_URL=https://n8n.example.de/webhook/wifaassist
JUDGE_MODEL=anthropic/claude-sonnet-5

# Optional
AGENT_REQUEST_FIELD=input
AGENT_RESPONSE_FIELD=output
AGENT_TIMEOUT_S=180
# TLS: false bei SSL-Problemen (Windows/self-signed). Gilt für alle HTTPS-Calls.
HTTP_VERIFY_SSL=false
AGENT_VERIFY_SSL=false
REQUEST_PAUSE_S=1.0
# Parallele Worker (I/O-bound; pro Config bzw. Judge)
GEN_WORKERS_A=2
GEN_WORKERS_B=2
GEN_WORKERS_CPLUS=6
JUDGE_WORKERS=6
RAG_SIMILARITY_TOP_K=5
WEB_SEARCH_ENGINE=native
WEB_SEARCH_CONTEXT_SIZE=medium
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_REASONING_EXCLUDE=true
